# ==============================================================================
# Subagent Lab - Environment Configuration Template
# Copy this file to .env and adjust variables as needed.
# ==============================================================================

# Local Ollama LLM Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:latest

# Optional: LangSmith Tracing & Observability
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=subagent-lab

# Optional: External Search API (Deterministic offline mocks used if omitted)
TAVILY_API_KEY=your_tavily_api_key_here
